# Rust
target/
backend/target/
**/*.rs.bk

# Node / Svelte
node_modules/
web/node_modules/
web/build/
web/.svelte-kit/
# SvelteKit writes this at the package root it is invoked from, so running any
# tool from the repo root instead of web/ drops a generated copy here.
/.svelte-kit/
npm-debug.log*
*.egg-info/
# web/package-lock.json is deliberately NOT ignored: it is tracked, and an
# ignore rule for a tracked file only creates the illusion that it is ignored.

# Environment and secrets
.env
.env.*
!.env.example
!.env.sample
credentials
secrets.*
*.key
*.pem
*.cert
*.p12

# Editor and swap files
*~
*.swp
*.swo
.idea/
.vscode/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
